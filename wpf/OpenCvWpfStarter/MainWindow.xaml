<Window x:Class="OpenCvWpfStarter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCV WPF 시작 템플릿" Height="620" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 상단 툴바 -->
            <RowDefinition Height="*" />      <!-- 가운데 이미지 -->
            <RowDefinition Height="Auto" />   <!-- 하단 상태 표시줄 -->
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="열기" Click="OpenButton_Click" Style="{StaticResource ToolButton}" />
            <Separator />
            <Button Content="흑백" Click="GrayButton_Click" Style="{StaticResource ToolButton}" />
            <Button Content="블러" Click="BlurButton_Click" Style="{StaticResource ToolButton}" />
            <Button Content="원본" Click="OriginalButton_Click" Style="{StaticResource ToolButton}" />
            <Separator />
            <Button Content="저장" Click="SaveButton_Click" Style="{StaticResource ToolButton}" />
        </ToolBar>

        <Border Grid.Row="1" Background="#FF2D2D30">
            <Image x:Name="MainImage" Stretch="Uniform" Margin="8" />
        </Border>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="[열기] 버튼으로 이미지를 불러오세요. (images/ 폴더에 예제 이미지가 있습니다)" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
